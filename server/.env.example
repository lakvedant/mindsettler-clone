# .env.example for server

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
# MongoDB connection URI (Atlas connection string or local MongoDB URI)
MONGO_URI=mongodb://localhost:27017/mindsettler

# Authentication Secrets
# Use a long, random string for JWT and session secrets
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d
SESSION_SECRET=your_session_secret_here

# Business settings
ADMIN_EMAIL=admin@example.com
SESSION_PRICE=500

# Email Configuration (Nodemailer)
# If using Gmail, configure SMTP settings and use an 'App Password'
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password

# AI Chatbot Integration (OpenRouter or Gemini API)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Deployment & Timezone Settings
# Frontend URL used for CORS configuration
FRONTEND_URL=http://localhost:5173
TZ=Asia/Kolkata
